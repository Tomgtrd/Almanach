	<link rel="stylesheet" href="../../mcu_style.css">
	<style>
		.members-grid {
			max-width: 880px;
			margin: 0 auto;
			padding: 24px 32px 100px;
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
			gap: 20px;
		}

		.member-card {
			display: block;
			text-decoration: none;
			color: inherit;
			background: var(--paper-raised);
			border: 1px solid var(--hairline);
			border-radius: var(--radius-md);
			padding: 28px 26px;
			opacity: 0;
			transform: translateY(16px);
			transition: opacity 0.6s ease, transform 0.6s ease,
				border-color 0.25s ease, box-shadow 0.25s ease;
		}

		.member-card.in {
			opacity: 1;
			transform: translateY(0);
		}

		.member-card:hover {
			border-color: var(--mcu-red-soft);
			box-shadow: 0 4px 18px rgba(28, 23, 18, 0.06);
		}

		.member-card__icon {
			width: 48px;
			height: 48px;
			border-radius: 50%;
			background: var(--mcu-cream);
			display: flex;
			align-items: center;
			justify-content: center;
			font-family: var(--font-display);
			font-size: 1.4rem;
			font-weight: 500;
			color: var(--mcu-red-soft);
			margin-bottom: 16px;
		}

		.member-card__name {
			font-family: var(--font-display);
			font-size: 1.35rem;
			font-weight: 500;
			margin: 0 0 6px;
			color: var(--ink);
		}

		.member-card__realname {
			font-family: var(--font-display);
			font-style: italic;
			font-size: 0.92rem;
			color: var(--ink-faint);
			margin: 0 0 14px;
		}

		.member-card__pitch {
			font-size: 0.92rem;
			color: var(--ink-soft);
			margin: 0;
			line-height: 1.55;
		}
	</style>
</head>

