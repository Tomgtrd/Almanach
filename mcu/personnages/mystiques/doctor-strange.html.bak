			max-width: 760px;
			margin: 0 auto;
			padding: 88px 32px 48px;
		}

		.charhero__tags {
			display: flex;
			flex-wrap: wrap;
			gap: 8px;
			margin: 24px 0 0;
		}

		.charhero__tag {
			font-family: var(--font-ui);
			font-size: 11px;
			letter-spacing: 0.04em;
			text-transform: uppercase;
			background: var(--mcu-cream);
			color: var(--mcu-red);
			padding: 4px 12px;
			border-radius: 999px;
		}

		.charhero__realname {
			font-family: var(--font-display);
			font-style: italic;
			font-size: 1.2rem;
			color: var(--ink-soft);
			margin: 4px 0 0;
		}
	</style>
</head>

<body>
	<nav class="mcu-topbar">
		<a class="mcu-topbar__almanach" href="../../../hub_index.html">← Almanach</a>
